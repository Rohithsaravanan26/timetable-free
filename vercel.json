{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/courses", "dest": "api/index.py" },
    { "src": "/generate", "dest": "api/index.py" },
    { "src": "/faculty/(.*)", "dest": "api/index.py" },
    { "src": "/review", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "env": {
    "DATABASE_URL": "@database_url"
  }
}
